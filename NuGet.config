<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    packageSources is defined explicitly. The rest of the estate declares a
    packageSourceMapping for deltazulu-github without ever defining the source,
    which fails restore from a clean checkout. Do not remove this section.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="deltazulu-github" value="https://nuget.pkg.github.com/DeltaZulu-OU/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="deltazulu-github">
      <package pattern="DeltaZulu.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
